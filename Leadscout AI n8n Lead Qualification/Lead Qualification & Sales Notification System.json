    {
      "parameters": {
        "jsCode": "// Validate contact info: email format + phone digit count (straight from the form fields)\nconst data = $input.first().json;\n\nconst name = (data['Name'] || '').trim();\nconst email = (data['Email'] || '').trim();\nconst phone = (data['Phone'] || '').trim();\nconst brief = (data['Brief'] || '').trim();\n\nconst emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\nconst isEmailValid = emailRegex.test(email);\n\n// Allow +, spaces, hyphens, parentheses, digits\nconst phoneAllowedChars = /^[0-9+\\-()\\s]+$/;\nconst digitCount = (phone.match(/\\d/g) || []).length;\nconst isPhoneValid = phone.length > 0 && phoneAllowedChars.test(phone) && digitCount >= 7 && digitCount <= 15;\n\nconst isValid = isEmailValid && isPhoneValid;\n\nreturn [{\n  json: {\n    name: name,\n    email: email,\n    phone: phone,\n    brief_text: brief,\n    is_valid: isValid,\n    validation_errors: [\n      !isEmailValid ? 'Invalid email format' : null,\n      !isPhoneValid ? 'Invalid phone number' : null\n    ].filter(Boolean)\n  }\n}];"
      },
      "id": "c8334bc5-0823-4a30-b341-ff882e66f7f6",
      "name": "Validate Contact Info",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
