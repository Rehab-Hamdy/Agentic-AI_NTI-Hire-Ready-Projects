    {
      "parameters": {
        "promptType": "define",
        "text": "=You are extracting structured lead data from a free-text business brief. Read the text below and pull out each field if it is present. If a field is not mentioned or cannot be determined, return an empty string for it — do NOT guess, invent, or infer values that are not stated or clearly implied.\n\nExtract these fields:\n- company_name\n- company_location\n- team_size\n- annual_revenue\n- budget\n- hiring_plans\n- problem: the problem/challenge they want solved\n- product_service: the product or service they're interested in\n- marketing_team_size\n- customer_growth_rate\n- expected_timeline: urgency/timeline\n- decision_authority: their role/authority in the buying decision\n\nReturn ONLY valid JSON matching the required schema.\n\nBrief:\n{{ $json.brief_text }}",
        "hasOutputParser": true
      },
      "id": "76728a0d-7868-4c25-9804-7424e7e389c0",
      "name": "Extract Lead Info",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.6,
      "position": [
        -272,
        816
      ]
    },
    {
      "parameters": {
        "jsCode": "// Merge the extracted business fields back with the validated contact fields\nconst extracted = $input.first().json.output || {};\nconst contact = $('Validate Contact Info').first().json;\n\nreturn [{\n  json: {\n    name: contact.name,\n    email: contact.email,\n    phone: contact.phone,\n    brief: contact.brief_text,\n    company_name: extracted.company_name || '',\n    company_location: extracted.company_location || '',\n    team_size: extracted.team_size || '',\n    annual_revenue: extracted.annual_revenue || '',\n    budget: extracted.budget || '',\n    hiring_plans: extracted.hiring_plans || '',\n    problem: extracted.problem || '',\n    product_service: extracted.product_service || '',\n    marketing_team_size: extracted.marketing_team_size || '',\n    customer_growth_rate: extracted.customer_growth_rate || '',\n    expected_timeline: extracted.expected_timeline || '',\n    decision_authority: extracted.decision_authority || ''\n  }\n}];"
      },
      "id": "f5132ac9-7485-4a4a-b025-f02eb3367988",
      "name": "Merge Extracted Fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -16,
        816
      ]
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"fit_score\": 0,\n  \"intent_score\": 0,\n  \"business_potential_score\": 0,\n  \"budget_score\": 0,\n  \"problem_score\": 0,\n  \"urgency_score\": 0,\n  \"decision_authority_score\": 0,\n  \"total_score\": 0,\n  \"rationale\": \"One concise sentence explaining the main reasons for the score.\"\n}"
      },
      "id": "c75a1092-a26c-46e8-947e-17823d463bb9",
      "name": "Scoring Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        304,
        592
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a strict B2B lead qualification analyst. Analyze the following lead's business information and stated need. Score ONLY based on the information explicitly provided. Do NOT invent missing information. Do NOT treat missing information as positive evidence. Do NOT judge the lead based on name, gender, age, nationality, grammar, writing quality, or language.\n\nScore the lead using these categories and maximum points:\n1. Product / Service Fit — 0 to 20\n2. Purchase Intent — 0 to 15\n3. Business Potential — 0 to 15\n4. Budget — 0 to 10\n5. Problem / Challenge — 0 to 10\n6. Urgency / Timeline — 0 to 10\n7. Decision-Making Authority — 0 to 10\n\ntotal_score must equal the exact sum of the seven scores above (maximum possible = 90).\n\nReturn ONLY valid JSON matching the required schema. The rationale must be exactly one concise sentence, based only on the information provided.\n\nLead Information:\nName: {{ $json.name }}\nCompany Name: {{ $json.company_name }}\nCompany Location: {{ $json.company_location }}\nTeam Size: {{ $json.team_size }}\nAnnual Revenue: {{ $json.annual_revenue }}\nBudget: {{ $json.budget }}\nHiring Plans: {{ $json.hiring_plans }}\nProblem / Challenge to Solve: {{ $json.problem }}\nProduct or Service of Interest: {{ $json.product_service }}\nMarketing Team Size: {{ $json.marketing_team_size }}\nCustomer Growth Rate: {{ $json.customer_growth_rate }}\nExpected Timeline / Urgency: {{ $json.expected_timeline }}\nDecision-Making Authority: {{ $json.decision_authority }}\nBrief / Additional Information: {{ $json.brief }}",
        "hasOutputParser": true
      },
      "id": "9dd12111-e64e-4795-a443-75b786ac45d0",
      "name": "Gemini LLM - Score Lead",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.6,
      "position": [
        128,
        816
      ]
    },
    {
      "parameters": {
        "jsCode": "// Generate a unique Lead ID and deterministic classification\nconst data = $input.first().json;\n\n// The chainLlm node with a structured output parser returns an \"output\" object\nconst scores = data.output ? data.output : data;\n\nconst now = new Date();\nconst y = now.getFullYear();\nconst m = String(now.getMonth() + 1).padStart(2, '0');\nconst d = String(now.getDate()).padStart(2, '0');\nconst datePart = `${y}${m}${d}`;\nconst randomPart = Math.floor(100 + Math.random() * 900); // 3-digit\nconst leadId = `LD-${datePart}-${randomPart}`;\n\nconst totalScore = Number(scores.total_score) || 0;\n\nlet classification;\nif (totalScore >= 72) {\n  classification = 'hot';\n} else if (totalScore >= 45) {\n  classification = 'warm';\n} else {\n  classification = 'cold';\n}\n\n// Merge extracted+validated lead data with scores + lead id\nconst leadData = $('Merge Extracted Fields').first().json;\n\nreturn [{\n  json: {\n    lead_id: leadId,\n    name: leadData.name,\n    email: leadData.email,\n    phone: leadData.phone,\n    company_name: leadData.company_name,\n    company_location: leadData.company_location,\n    team_size: leadData.team_size,\n    annual_revenue: leadData.annual_revenue,\n    budget: leadData.budget,\n    hiring_plans: leadData.hiring_plans,\n    problem: leadData.problem,\n    product_service: leadData.product_service,\n    marketing_team_size: leadData.marketing_team_size,\n    customer_growth_rate: leadData.customer_growth_rate,\n    expected_timeline: leadData.expected_timeline,\n    decision_authority: leadData.decision_authority,\n    brief: leadData.brief,\n    fit_score: Number(scores.fit_score) || 0,\n    intent_score: Number(scores.intent_score) || 0,\n    business_potential_score: Number(scores.business_potential_score) || 0,\n    budget_score: Number(scores.budget_score) || 0,\n    problem_score: Number(scores.problem_score) || 0,\n    urgency_score: Number(scores.urgency_score) || 0,\n    decision_authority_score: Number(scores.decision_authority_score) || 0,\n    total_score: totalScore,\n    classification: classification,\n    rationale: scores.rationale || '',\n    notification_sent: 'No'\n  }\n}];"
      },
